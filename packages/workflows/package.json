{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@phall1/opencode-workflows",
  "version": "0.0.1",
  "description": "Typed workflow graphs for OpenCode V2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phall1/opencode-plugins.git",
    "directory": "packages/workflows"
  },
  "homepage": "https://github.com/phall1/opencode-plugins/tree/main/packages/workflows",
  "bugs": "https://github.com/phall1/opencode-plugins/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "workflow",
    "tui"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dsl": "./src/dsl.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./tui.js"
  },
  "files": [
    "src",
    "server.ts",
    "tui.tsx",
    "tui.js",
    "index.ts",
    "rpc.ts",
    "docs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run typecheck && bun run compile && bun run test",
    "compile": "bun scripts/build.mjs",
    "test": "bun test",
    "test:tui": "opencode-drive run scripts/tui-drive.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.32",
    "opentui-spinner": "0.0.7"
  },
  "peerDependencies": {
    "effect": "^4.0.1",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@opencode/theme": "2.0.32",
    "opencode-drive": "2.3.0",
    "effect": "4.0.1",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "1.9.12"
  }
}
